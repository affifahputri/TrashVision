<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrashVision</title>

    <style>
        body {
            display: flex;
            flex-direction: column; /* Biar elemen tersusun dari atas ke bawah */
            align-items: center;    /* Pusatkan secara horizontal */
            justify-content: center; /* Pusatkan secara vertikal */
            min-height: 100vh;      /* Paksa tinggi body seukuran layar monitor */
            margin: 0;
            background-color: #0f172a; /* Sesuaikan dengan warna background gelapmu */
            color: white;
        }
    </style>
</head>
<body>

    @RenderBody()

    @RenderSection("Scripts", required: false)

</body>
</html>
