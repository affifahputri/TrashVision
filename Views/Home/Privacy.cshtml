@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    :root {
        --navy-dark: #0a192f;
        --navy-main: #112240;
        --gray-dark: #1f2933;
        --gray-light: #9ca3af;
        --white: #ffffff;
        --accent: #38bdf8;
    }

    /* PAGE WRAPPER (ANTI PUTIH) */
    .privacy-page {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--navy-dark), var(--gray-dark));
        color: var(--white);
    }

    /* HERO */
    .privacy-hero {
        min-height: 40vh;
        padding: 140px 20px 60px;
        text-align: center;
        background: linear-gradient(135deg, var(--navy-dark), var(--navy-main));
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .privacy-hero h1 {
            font-size: clamp(32px, 5vw, 48px);
            margin-top: 30px;
        }

    .btn-back {
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 30px;
        background: var(--accent);
        color: var(--navy-dark);
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-back:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(56,189,248,0.4);
        }

    /* CONTENT */
    .privacy-content {
        padding: 90px 8vw;
        background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent);
    }

    .privacy-card {
        max-width: 900px;
        margin: auto;
        background: rgba(255,255,255,0.06);
        padding: 45px;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 45px rgba(0,0,0,0.35);
    }

        .privacy-card h2 {
            margin-top: 35px;
            margin-bottom: 15px;
            color: var(--accent);
            font-size: 24px;
        }

        .privacy-card p {
            line-height: 1.8;
            color: var(--gray-light);
            font-size: 16px;
        }

    /* RESPONSIVE */
    (max-width: 768px) {
        .privacy-content

    {
        padding: 70px 6vw;
    }

    .privacy-card {
        padding: 30px;
    }

    }
</style>

<div class="privacy-page">

    <!-- HERO -->
    <div class="privacy-hero">
        <a asp-controller="Home" asp-action="Index" class="btn-back">
            ⬅ Kembali ke Beranda
        </a>

        <h1>@ViewData["Title"]</h1>
    </div>

    <!-- CONTENT -->
    <div class="privacy-content">
        <div class="privacy-card">
            <h2>🔒 Kebijakan Privasi</h2>
            <p>
                Halaman ini menjelaskan bagaimana TrashVision mengelola,
                menggunakan, dan melindungi data pengguna.
            </p>

            <h2>📷 Data Gambar</h2>
            <p>
                Gambar yang diunggah hanya digunakan untuk proses deteksi
                dan klasifikasi jenis sampah dan tidak disimpan permanen.
            </p>

            <h2>🛡️ Keamanan Data</h2>
            <p>
                Sistem menerapkan standar keamanan untuk mencegah akses
                tidak sah dan menjaga integritas data.
            </p>
        </div>
    </div>

</div>
