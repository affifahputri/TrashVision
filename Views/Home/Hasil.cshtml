@{
    ViewData["Title"] = "Hasil Deteksi Sampah";
    var imageUrl = ViewData["ImageUrl"] ?? Url.Content("~/uploads/placeholder.png");
    var jenis = ViewData["Jenis"] ?? "Tidak diketahui";
    var waktu = ViewData["Waktu"] ?? DateTime.Now.ToString("dd MMM yyyy HH:mm");
}

<style>
    /* page wrapper */
    #main-result-wrapper {
        width: 100%;
        min-height: calc(100vh - 72px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 32px 16px;
        box-sizing: border-box;
    }

    /* centered card */
    .result-card {
        width: min(820px, 95%);
        background: linear-gradient(180deg, rgba(15,32,39,0.95), rgba(8,20,30,0.95));
        color: #e6eef6;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(2,6,23,0.6);
        border: 1px solid rgba(255,255,255,0.04);
        box-sizing: border-box;
        text-align: center; /* center text and controls */
        margin: 0;
    }

    .result-header {
        font-size: 1.4rem;
        font-weight: 800;
        margin-bottom: 18px;
        text-align: left; /* keep header aligned left for clarity */
    }

    /* stack vertically and center the photo + info */
    .result-body {
        display: flex;
        flex-direction: column;
        gap: 18px;
        align-items: center;
        justify-content: center;
    }

    /* center the image and make it responsive */
    .result-image {
        width: min(420px, 90%);
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        overflow: hidden;
        background: #0b1320;
        box-shadow: 0 6px 18px rgba(2,6,23,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .result-image img {
        width: 100%;
        height: auto;
        object-fit: contain; /* keep full image visible */
        display: block;
    }

    .result-info {
        width: 100%;
        max-width: 720px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: center;
        padding: 0 8px;
        text-align: center;
    }

    .label { color:#9fb4c8; font-size:0.95rem; }
    .value { font-weight:700; font-size:1.05rem; color:#ffffff; }

    .meta-row {
        margin-top: 6px;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-link {
        padding:8px 14px;
        border-radius:20px;
        background:linear-gradient(90deg,#06b6d4,#3b82f6);
        color:#041426;
        font-weight:700;
        text-decoration:none;
    }

    @media (max-width:640px) {
        #main-result-wrapper { padding:20px; min-height:auto; }
        .result-card { padding:16px; }
        .result-body { flex-direction:column; align-items:center; text-align:center; }
        .result-image { width:100%; max-width:420px; height:260px; }
        .result-info { text-align:center; padding-top:12px; }
    }
</style>

<div id="main-result-wrapper" role="main">
    <div class="result-card" role="region" aria-labelledby="resultTitle">
        <div class="result-header" id="resultTitle">Hasil Deteksi Sampah</div>

        <div class="result-body">
            <div class="result-image" aria-hidden="false">
                <img src="@imageUrl" alt="Hasil foto deteksi" />
            </div>

            <div class="result-info">
                <div>
                    <div class="label">Jenis Sampah</div>
                    <div class="value">@jenis</div>
                </div>

                <div class="meta-row">
                    <div class="muted" style="color:#9fb4c8;font-size:0.95rem;">Waktu: @waktu</div>
                    <a href="@Url.Action("Upload", "Home")" class="btn-link" aria-label="Deteksi lagi">Deteksi Lagi</a>
                </div>
            </div>
        </div>
    </div>
</div>
